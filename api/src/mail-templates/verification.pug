html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Document
  body
    table(style="font-family: Arial, Helvetica, sans-serif")
      tr
        td(style="padding-bottom: 24px; font-size: 24px; font-weight: 600") Hi #{customer.name},
      tr
        td(style="padding-bottom: 16px;") Thank you for signing up with us. To verify your email, please enter the following
      tr
        td(style="padding-bottom: 16px; text-align: center") One Time Password (OTP): <strong>#{code}</strong> 
      tr
        td(style="padding-bottom: 24px;") It will expire in 5 minutes.
      tr
        td(style="") Sincerely, <strong>QuickBite Team</strong>